<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <!-- Nom du véhicule + à propos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/infoBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="À propos"
                android:src="@drawable/ic_info"
                android:tint="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- Essence / batterie + autonomie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/energyIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@null"
                android:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/energyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="21sp" />
        </LinearLayout>

        <!-- Image du véhicule -->
        <ImageView
            android:id="@+id/carImage"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="Véhicule"
            android:scaleType="fitCenter" />

        <!-- Actions -->
        <include android:id="@+id/rowCharge" layout="@layout/row_item" />
        <include android:id="@+id/rowClimate" layout="@layout/row_item" />
        <include android:id="@+id/rowLock" layout="@layout/row_item" />
        <include android:id="@+id/rowChargeLimit" layout="@layout/row_item" />
        <include android:id="@+id/rowStatus" layout="@layout/row_item" />
        <include android:id="@+id/rowOdometer" layout="@layout/row_item" />
        <include android:id="@+id/row12v" layout="@layout/row_item" />
        <include android:id="@+id/rowLocation" layout="@layout/row_item" />
        <include android:id="@+id/rowWalk" layout="@layout/row_item" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="60dp" />

        <!-- Réglages -->
        <LinearLayout
            android:id="@+id/rowSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                android:tint="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Réglages"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
