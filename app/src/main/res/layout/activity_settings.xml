<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Hint"
            android:text="@string/settings_privacy" />

        <!-- ============ Langue ============ -->
        <TextView style="@style/SectionTitle" android:text="@string/sec_language" />

        <LinearLayout style="@style/Card">
            <Spinner
                android:id="@+id/spLang"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- ============ Compte ============ -->
        <TextView style="@style/SectionTitle" android:text="@string/sec_account" />

        <LinearLayout style="@style/Card">

            <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/email" />
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress" />

            <TextView style="@style/Label" android:text="@string/password" />
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:inputType="textPassword" />

            <TextView style="@style/Label" android:text="@string/pin" />
            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberPassword"
                android:maxLength="4" />

            <TextView style="@style/Label" android:text="@string/mfa_via" />
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:text="@string/mfa_email" />

                <RadioButton
                    android:id="@+id/rbSms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mfa_sms" />
            </RadioGroup>

            <TextView style="@style/Label" android:text="@string/display_name" />
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/display_name_hint"
                android:inputType="textCapSentences" />
        </LinearLayout>

        <!-- ============ Climatisation ============ -->
        <TextView style="@style/SectionTitle" android:text="@string/sec_climate" />

        <LinearLayout style="@style/Card">

            <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/warm_temp" />
            <Spinner
                android:id="@+id/spWarmTemp"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <CheckBox
                android:id="@+id/cbWarmFront"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/front_defrost" />

            <CheckBox
                android:id="@+id/cbWarmRear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rear_defrost" />

            <CheckBox
                android:id="@+id/cbWarmSteering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/steering_heat" />

            <TextView style="@style/Label" android:text="@string/warm_seats" />
            <Spinner
                android:id="@+id/spWarmSeat"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView style="@style/Label" android:layout_marginTop="18dp" android:text="@string/cool_temp" />
            <Spinner
                android:id="@+id/spCoolTemp"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView style="@style/Label" android:text="@string/cool_seats" />
            <Spinner
                android:id="@+id/spCoolSeat"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <CheckBox
                android:id="@+id/cbSeatsAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/seats_all" />

            <TextView style="@style/Label" android:text="@string/duration" />
            <Spinner
                android:id="@+id/spDuration"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- ============ Démarrage programmé ============ -->
        <TextView
            android:id="@+id/schedSection"
            style="@style/SectionTitle"
            android:text="@string/sec_schedule" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/swSched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sched_enable"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView style="@style/Hint" android:text="@string/sched_hint" />

            <TextView style="@style/Label" android:layout_marginTop="14dp" android:text="@string/sched_time" />
            <Button
                android:id="@+id/btnSchedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:textSize="18sp" />

            <TextView style="@style/Label" android:text="@string/sched_days" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/cbD0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <CheckBox android:id="@+id/cbD1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <CheckBox android:id="@+id/cbD2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <CheckBox android:id="@+id/cbD3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <CheckBox android:id="@+id/cbD4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <CheckBox android:id="@+id/cbD5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <CheckBox android:id="@+id/cbD6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="@string/sched_mode" />
            <Spinner
                android:id="@+id/spSchedMode"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView style="@style/Label" android:text="@string/sched_warm_below" />
            <Spinner
                android:id="@+id/spWarmBelow"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView style="@style/Label" android:text="@string/sched_cool_above" />
            <Spinner
                android:id="@+id/spCoolAbove"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- ============ Stationnement ============ -->
        <TextView style="@style/SectionTitle" android:text="@string/sec_parking" />

        <LinearLayout style="@style/Card">
            <Switch
                android:id="@+id/swPark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/park_enable"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView style="@style/Hint" android:text="@string/park_hint" />
        </LinearLayout>

        <!-- ============ Alertes ============ -->
        <TextView style="@style/SectionTitle" android:text="@string/sec_alerts" />

        <LinearLayout style="@style/Card">

            <TextView style="@style/Hint" android:layout_marginTop="0dp" android:text="@string/alerts_hint" />

            <Switch
                android:id="@+id/swAlertUnlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/alert_unlocked"
                android:textSize="15sp" />

            <TextView style="@style/Label" android:layout_marginTop="4dp" android:text="@string/alert_unlocked_after" />
            <Spinner
                android:id="@+id/spUnlockedMin"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <Switch
                android:id="@+id/swAlertOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/alert_open"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swAlert12v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/alert_12v"
                android:textSize="15sp" />

            <TextView style="@style/Label" android:layout_marginTop="4dp" android:text="@string/alert_12v_below" />
            <Spinner
                android:id="@+id/sp12v"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- ============ Véhicule ============ -->
        <TextView style="@style/SectionTitle" android:text="@string/vehicle" />

        <LinearLayout style="@style/Card">

            <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/tank" />
            <EditText
                android:id="@+id/etTank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
            <TextView style="@style/Hint" android:text="@string/tank_hint" />

            <TextView style="@style/Label" android:text="@string/trim" />
            <Spinner
                android:id="@+id/spTrim"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView style="@style/Label" android:text="@string/color" />
            <Spinner
                android:id="@+id/spColor"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- ============ Verrouillage auto ============ -->
        <TextView
            android:id="@+id/walkSection"
            style="@style/SectionTitle"
            android:text="@string/sec_walk" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/swWalk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/walk_enable"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView style="@style/Hint" android:text="@string/walk_hint" />

            <TextView
                android:id="@+id/tvWalkDevice"
                style="@style/Label"
                android:layout_marginTop="14dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnWalkDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/walk_pick" />

            <TextView style="@style/Label" android:text="@string/walk_delay" />
            <Spinner
                android:id="@+id/spWalkDelay"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <CheckBox
                android:id="@+id/cbWalkConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/walk_confirm" />

            <CheckBox
                android:id="@+id/cbWalkNotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/walk_notify" />

            <TextView
                android:id="@+id/tvBattery"
                style="@style/Hint"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_btn" />

            <Button
                android:id="@+id/btnWalkTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/walk_test" />

            <TextView style="@style/Hint" android:text="@string/walk_warning" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/accent"
            android:text="@string/save"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnReset"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reset_all"
            android:textColor="@color/warn" />
    </LinearLayout>
</ScrollView>
